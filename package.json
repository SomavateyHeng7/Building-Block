{
  "name": "building-block",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "perf": "vitest run --config vitest.perf.config.mts",
    "testerarmy:sync": "node testerarmy/sync.mjs",
    "test:browser": "ta ci --project \"$TESTERARMY_PROJECT_ID\" --group \"$TESTERARMY_GROUP_ID\" --target-url \"$TESTERARMY_URL\""
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "testerarmy": "0.10.1",
    "typescript": "^5",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@9.5.0",
  "pnpm": {
    "overrides": {
      "dompurify@<3.4.17": "^3.4.17",
      "zod@>=4.0.0 <4.6.6": "^4.6.6"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-react>eslint": "10",
        "eslint-plugin-jsx-a11y>eslint": "10",
        "eslint-plugin-import>eslint": "10"
      }
    }
  }
}
