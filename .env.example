# Copy these into the hosting dashboard (Vercel etc.). `NEXT_PUBLIC_*` values are compiled into the
# JavaScript, so changing one needs a rebuild and redeploy. See docs/16-operations.md.

# Address people write to on /contact. Without it the page points to the website and social pages instead,
# so set it: the privacy notice sends people there for data requests.
NEXT_PUBLIC_CONTACT_EMAIL=

# Form endpoint for the waitlist (a JSON POST of { email, source, consent }), e.g. a Formspree URL.
# Without it the waitlist form is not shown. The privacy page names this URL's host as the provider.
NEXT_PUBLIC_WAITLIST_URL=

# Cloudflare Web Analytics token. Without it no visits are counted.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# The site's public address, e.g. https://buildingblock.app. Used for absolute links in the sitemap, robots.txt
# and link previews; on Vercel the production domain is used when this is empty. Rebuild after changing it.
SITE_URL=

# Maintenance mode (read per request, no rebuild needed)
MAINTENANCE_MODE=
MAINTENANCE_UNTIL=
MAINTENANCE_MESSAGE=
MAINTENANCE_BYPASS_TOKEN=
